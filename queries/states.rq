PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT
  ?state
  (wd:Q30                  AS ?country)
  (SAMPLE(?name_v)        AS ?name)
  (SAMPLE(?coords_v)      AS ?coords)
  (SAMPLE(?area_v)        AS ?area_km2)
  (SAMPLE(?population_v)  AS ?population)
  (SAMPLE(?capital_v)     AS ?capital)
  (SAMPLE(?inception_v)   AS ?inception)
  (SAMPLE(?iso_v)         AS ?iso_code)
  (SAMPLE(?nickname_v)    AS ?nickname)
  (SAMPLE(?website_v)     AS ?website)
WHERE {
  ?state wdt:P31/wdt:P279* wd:Q35657 .  # instance of US state
  ?state wdt:P17 wd:Q30 .               # country = United States

  ?state rdfs:label ?name_v .
  FILTER(LANG(?name_v) = "en")

  OPTIONAL { ?state wdt:P625  ?coords_v }
  OPTIONAL { ?state wdt:P2046 ?area_v }
  OPTIONAL { ?state wdt:P1082 ?population_v }
  OPTIONAL { ?state wdt:P36   ?capital_v }
  OPTIONAL { ?state wdt:P571  ?inception_v }
  OPTIONAL { ?state wdt:P300  ?iso_v }
  OPTIONAL { ?state wdt:P1449 ?nickname_v }
  OPTIONAL { ?state wdt:P856  ?website_v }
}
GROUP BY ?state
ORDER BY ?name
