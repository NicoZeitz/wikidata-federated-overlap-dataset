PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT
  ?company
  (SAMPLE(?name_v)             AS ?name)
  (GROUP_CONCAT(DISTINCT ?typeLabel;  SEPARATOR=", ") AS ?types)
  (GROUP_CONCAT(DISTINCT ?indLabel;   SEPARATOR=", ") AS ?industries)
  (SAMPLE(?legalFormLabel_v)   AS ?legal_form)
  (SAMPLE(?inception_v)        AS ?inception)
  (SAMPLE(?website_v)          AS ?website)
  (SAMPLE(?city_v)             AS ?city)
  (SAMPLE(?country_v)          AS ?country)
  (SAMPLE(?ceo_v)              AS ?ceo_person)
  (SAMPLE(?employees_v)        AS ?employees)
  (SAMPLE(?revenue_v)          AS ?revenue_usd)
  (SAMPLE(?netIncome_v)        AS ?net_income_usd)
  (SAMPLE(?totalAssets_v)      AS ?total_assets_usd)
  (SAMPLE(?operatingIncome_v)  AS ?operating_income_usd)
  (SAMPLE(?marketCap_v)        AS ?market_cap_usd)
WHERE {
  ?company wdt:P31 wd:Q4830453 .
  FILTER NOT EXISTS { ?company wdt:P576 ?dissolved . }

  ?company rdfs:label ?name_v .
  FILTER(lang(?name_v) = "en")

  OPTIONAL { ?company wdt:P571  ?inception_v . }
  OPTIONAL { ?company wdt:P159 ?city_v . }
  {
    SELECT ?company (SAMPLE(?c) AS ?country_v) WHERE {
      { ?company wdt:P17 ?_c . }
      UNION
      { ?company wdt:P159 ?hq . ?hq wdt:P17 ?_c . }
      BIND(IF(?_c = wd:Q756617, wd:Q35, ?_c) AS ?c)
      ?c wdt:P31 wd:Q3624078 .
      ?c wdt:P297 [] .
      FILTER NOT EXISTS { ?c wdt:P576 ?cdiss . }
    } GROUP BY ?company
  }
  OPTIONAL { ?company wdt:P856  ?website_v . }
  OPTIONAL {
    ?company wdt:P169  ?ceo_v .
    ?ceo_v wdt:P31 wd:Q5 .
    FILTER EXISTS {
      { ?ceo_v wdt:P27 ?_cc . FILTER NOT EXISTS { ?_cc wdt:P576 ?_cd . } }
      UNION
      { ?ceo_v wdt:P19 ?_cbp . ?_cbp wdt:P17 ?_cbc . FILTER NOT EXISTS { ?_cbc wdt:P576 ?_cbcd . } }
    }
  }
  OPTIONAL { ?company wdt:P1128 ?employees_v . }
  OPTIONAL { ?company wdt:P2139 ?revenue_v . }
  OPTIONAL { ?company wdt:P2295 ?netIncome_v . }
  OPTIONAL { ?company wdt:P2403 ?totalAssets_v . }
  OPTIONAL { ?company wdt:P3362 ?operatingIncome_v . }
  OPTIONAL { ?company wdt:P2226 ?marketCap_v . }

  OPTIONAL {
    ?company wdt:P31 ?typeEntity .
    ?typeEntity rdfs:label ?typeLabel .
    FILTER(lang(?typeLabel) = "en")
  }

  OPTIONAL {
    ?company wdt:P452 ?indEntity .
    ?indEntity rdfs:label ?indLabel .
    FILTER(lang(?indLabel) = "en")
  }

  OPTIONAL {
    ?company wdt:P1454 ?legalFormEntity .
    ?legalFormEntity rdfs:label ?legalFormLabel_v .
    FILTER(lang(?legalFormLabel_v) = "en")
  }
}
GROUP BY ?company
