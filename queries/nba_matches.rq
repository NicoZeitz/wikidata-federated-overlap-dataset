PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT
?game
(SAMPLE(?country_v)     AS ?country)
(SAMPLE(?team1_v)       AS ?team1)
(SAMPLE(?team1Label_v)  AS ?team1Label)
(SAMPLE(?team2_v)       AS ?team2)
(SAMPLE(?team2Label_v)  AS ?team2Label)
(SAMPLE(?winnerLabel_v) AS ?winnerLabel)
(SAMPLE(?venueLabel_v)  AS ?venueLabel)
(SAMPLE(?date_v)        AS ?date)
(MAX(?attendance_v)     AS ?attendance)
(SAMPLE(?seasonLabel_v) AS ?seasonLabel)
WHERE {
?game wdt:P31 wd:Q18431960 .
?game wdt:P361 ?season .
?season wdt:P3450 wd:Q155223 .

?game rdfs:label ?label . FILTER(LANG(?label) = "en")
?season rdfs:label ?seasonLabel_v . FILTER(LANG(?seasonLabel_v) = "en")

?game wdt:P1923 ?team1_v .
?game wdt:P1923 ?team2_v .
FILTER(?team1_v < ?team2_v)

?team1_v rdfs:label ?team1Label_v . FILTER(LANG(?team1Label_v) = "en")
?team2_v rdfs:label ?team2Label_v . FILTER(LANG(?team2Label_v) = "en")

?team1_v wdt:P17/wdt:P17? ?country_v .

OPTIONAL { ?game wdt:P585  ?date_v }
OPTIONAL { ?game wdt:P1346 ?winner .
           ?winner rdfs:label ?winnerLabel_v .
           FILTER(LANG(?winnerLabel_v) = "en") }
OPTIONAL { ?game wdt:P276  ?venue .
           ?venue rdfs:label ?venueLabel_v .
           FILTER(LANG(?venueLabel_v) = "en") }
OPTIONAL { ?game wdt:P1110 ?attendance_v }
}
GROUP BY ?game
ORDER BY DESC(?date_v)
